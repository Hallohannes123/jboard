{
  "name": "@wb/crdt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./yjs": {
      "types": "./dist/adapters/yjs.d.ts",
      "default": "./dist/adapters/yjs.js"
    },
    "./automerge": {
      "types": "./dist/adapters/automerge.d.ts",
      "default": "./dist/adapters/automerge.js"
    },
    "./loro": {
      "types": "./dist/adapters/loro.d.ts",
      "default": "./dist/adapters/loro.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "default": "./dist/model.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@automerge/automerge": "3.3.2",
    "loro-crdt": "1.13.8",
    "yjs": "13.6.31"
  }
}
