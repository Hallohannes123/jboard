{
  "name": "jboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20.20 <21",
    "pnpm": ">=10.18 <11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "bench": "node --expose-gc bench/dist/run-all.js",
    "analyze": "node bench/dist/analyze-run.js",
    "bench:browser": "playwright test --config bench/browser/playwright.config.ts",
    "bench:browser:report": "node bench/dist/browser-report.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
